{
  "name": "automate-monorepo",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",

    "db:generate": "pnpm --filter @repo/db generate",
    "db:build": "pnpm --filter @repo/db build"
  }
}
